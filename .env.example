# ===================================================================
# DyDo PRM Assistant - Supabase & Mobil Uygulama Yapılandırma Şablonu
# ===================================================================

# 1. PRM Web Sistemi Origin (Eklentinin çalışacağı adres)
VITE_PRM_ORIGIN=https://dydoprm.visionplus.com.tr/*

# 2. Ortak Kullanıcı Hesabı (Eklenti ve Mobil Uygulama Ortak Girişi)
VITE_CLOUD_EMAIL=admin@dydo.com
VITE_CLOUD_PASSWORD=YOUR_PASSWORD_HERE

# 3. Supabase Veritabanı Ayarları
# Supabase Dashboard -> Project Settings -> API kısmından alabilirsiniz:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
